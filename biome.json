{
  "$schema": "node_modules/@biomejs/biome/configuration_schema.json",
  "files": { "ignoreUnknown": true, "includes": ["**", "!!.agents/skills"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 80 },
  "css": { "parser": { "tailwindDirectives": true } },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "linter": {
    "domains": { "solid": "all" },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 10 }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": { "maxLines": 40, "skipBlankLines": true }
        },
        "useMathMinMax": "off"
      },
      "correctness": {
        "noSolidDestructuredProps": "error",
        "noUndeclaredDependencies": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error",
        "useSolidForComponent": "error"
      },
      "security": { "noSecrets": "off" },
      "style": {
        "useConsistentArrayType": {
          "level": "error",
          "options": { "syntax": "generic" }
        },
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": { "maxLines": 300, "skipBlankLines": true }
        },
        "noExportedImports": "error",
        "noNestedTernary": "error",
        "noParameterAssign": {
          "level": "error",
          "options": { "propertyAssignment": "deny" }
        },
        "noUselessElse": "error",
        "useReadonlyClassProperties": "error"
      },
      "suspicious": { "noVar": "error" }
    }
  },
  "vcs": { "clientKind": "git", "enabled": true, "useIgnoreFile": true },
  "overrides": [
    {
      "includes": ["packages/business/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "*",
                      "**",
                      "!effect",
                      "!effect/**",
                      "!./**",
                      "!../**",
                      "**/apps/**"
                    ],
                    "message": "packages/business depends on effect only; no package imports apps/reader (reader-engineering: Packages)"
                  },
                  {
                    "group": [
                      "**/test/**",
                      "**/test",
                      "@reader/business/testing",
                      "@reader/sqlite/testing"
                    ],
                    "message": "src/ must not import test/ code or a */testing entry (reader-engineering: Testing)"
                  }
                ]
              }
            }
          },
          "correctness": { "noNodejsModules": "error" }
        }
      }
    },
    {
      "includes": ["packages/sqlite/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "*",
                      "**",
                      "!effect",
                      "!effect/**",
                      "!@effect/sql-sqlite-node",
                      "!@effect/sql-sqlite-node/**",
                      "!@reader/business",
                      "!node:*",
                      "!./**",
                      "!../**",
                      "**/apps/**"
                    ],
                    "message": "packages/sqlite depends on effect, @effect/sql-sqlite-node, @reader/business and node: modules only; no package imports apps/reader (reader-engineering: Packages)"
                  },
                  {
                    "group": [
                      "**/test/**",
                      "**/test",
                      "@reader/business/testing",
                      "@reader/sqlite/testing"
                    ],
                    "message": "src/ must not import test/ code or a */testing entry (reader-engineering: Testing)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/content/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "*",
                      "**",
                      "!effect",
                      "!effect/**",
                      "!@reader/business",
                      "!feedsmith",
                      "!jsdom",
                      "!@mozilla/readability",
                      "!dompurify",
                      "!./**",
                      "!../**",
                      "**/apps/**"
                    ],
                    "message": "packages/content depends on effect, @reader/business, feedsmith, jsdom, @mozilla/readability and dompurify only; no package imports apps/reader (reader-engineering: Packages)"
                  },
                  {
                    "group": [
                      "**/test/**",
                      "**/test",
                      "@reader/business/testing",
                      "@reader/sqlite/testing"
                    ],
                    "message": "src/ must not import test/ code or a */testing entry (reader-engineering: Testing)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/webpage/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "*",
                      "**",
                      "!effect",
                      "!effect/**",
                      "!@reader/business",
                      "!puppeteer-core",
                      "!ws",
                      "!node:*",
                      "!./**",
                      "!../**",
                      "**/apps/**"
                    ],
                    "message": "packages/webpage depends on effect, @reader/business, puppeteer-core, ws and node: modules only; no package imports apps/reader (reader-engineering: Packages)"
                  },
                  {
                    "group": [
                      "**/test/**",
                      "**/test",
                      "@reader/business/testing",
                      "@reader/sqlite/testing"
                    ],
                    "message": "src/ must not import test/ code or a */testing entry (reader-engineering: Testing)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/reader/src/contract/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "*",
                      "**",
                      "!effect",
                      "!effect/**",
                      "!@reader/business",
                      "!./**",
                      "!../**"
                    ],
                    "message": "src/contract depends on effect and @reader/business only (reader-engineering: Packages)"
                  },
                  {
                    "group": [
                      "**/test/**",
                      "**/test",
                      "@reader/business/testing",
                      "@reader/sqlite/testing"
                    ],
                    "message": "src/ must not import test/ code or a */testing entry (reader-engineering: Testing)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/reader/src/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/server/**",
                      "@reader/sqlite",
                      "@reader/sqlite/**",
                      "@reader/content",
                      "@reader/content/**",
                      "@reader/webpage",
                      "@reader/webpage/**",
                      "@reader/business",
                      "@reader/business/**",
                      "node:*",
                      "@effect/platform-node",
                      "@effect/platform-node/**",
                      "@effect/sql-*",
                      "better-auth",
                      "better-auth/*",
                      "!better-auth/solid"
                    ],
                    "message": "src/web must not import the server, the adapter packages, node: modules or Better Auth's server entry; entity types reach it through the contract (reader-engineering: Packages)"
                  },
                  {
                    "group": ["effect", "effect/*", "effect/**"],
                    "message": "Only api/ may import Effect in the web client; stores and components await its Promise-returning functions (reader-engineering: apps/reader)"
                  },
                  {
                    "group": [
                      "**/test/**",
                      "**/test",
                      "@reader/business/testing",
                      "@reader/sqlite/testing"
                    ],
                    "message": "src/ must not import test/ code or a */testing entry (reader-engineering: Testing)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/reader/src/web/api/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/server/**",
                      "@reader/sqlite",
                      "@reader/sqlite/**",
                      "@reader/content",
                      "@reader/content/**",
                      "@reader/webpage",
                      "@reader/webpage/**",
                      "@reader/business",
                      "@reader/business/**",
                      "node:*",
                      "@effect/platform-node",
                      "@effect/platform-node/**",
                      "@effect/sql-*",
                      "better-auth",
                      "better-auth/*",
                      "!better-auth/solid"
                    ],
                    "message": "src/web must not import the server, the adapter packages, node: modules or Better Auth's server entry; entity types reach it through the contract (reader-engineering: Packages)"
                  },
                  {
                    "group": [
                      "solid-js",
                      "solid-js/*",
                      "@solidjs/*",
                      "**/library/**",
                      "**/library",
                      "**/saved-page/**",
                      "**/saved-page",
                      "**/feed/**",
                      "**/feed",
                      "**/folder/**",
                      "**/folder",
                      "**/setting/**",
                      "**/setting",
                      "**/reader/**",
                      "**/reader",
                      "**/account/**",
                      "**/account",
                      "**/ui/**",
                      "**/ui",
                      "**/routes",
                      "**/routes/**"
                    ],
                    "message": "api/ must not use Solid or the router, nor the other web modules; it only exposes Promise-returning functions (reader-engineering: apps/reader)"
                  },
                  {
                    "group": [
                      "**/test/**",
                      "**/test",
                      "@reader/business/testing",
                      "@reader/sqlite/testing"
                    ],
                    "message": "src/ must not import test/ code or a */testing entry (reader-engineering: Testing)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/reader/src/web/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/server/**",
                      "@reader/sqlite",
                      "@reader/sqlite/**",
                      "@reader/content",
                      "@reader/content/**",
                      "@reader/webpage",
                      "@reader/webpage/**",
                      "@reader/business",
                      "@reader/business/**",
                      "node:*",
                      "@effect/platform-node",
                      "@effect/platform-node/**",
                      "@effect/sql-*",
                      "better-auth",
                      "better-auth/*",
                      "!better-auth/solid"
                    ],
                    "message": "src/web must not import the server, the adapter packages, node: modules or Better Auth's server entry; entity types reach it through the contract (reader-engineering: Packages)"
                  },
                  {
                    "group": ["effect", "effect/*", "effect/**"],
                    "message": "Only api/ may import Effect in the web client; stores and components await its Promise-returning functions (reader-engineering: apps/reader)"
                  },
                  {
                    "group": [
                      "**/library/**",
                      "**/library",
                      "**/saved-page/**",
                      "**/saved-page",
                      "**/feed/**",
                      "**/feed",
                      "**/folder/**",
                      "**/folder",
                      "**/setting/**",
                      "**/setting",
                      "**/reader/**",
                      "**/reader",
                      "**/account/**",
                      "**/account",
                      "**/routes",
                      "**/routes/**",
                      "**/api/**",
                      "**/api"
                    ],
                    "message": "ui/ carries no domain: it may not use the api client or the domain modules, and receives data through props (reader-engineering: apps/reader)"
                  },
                  {
                    "group": [
                      "**/test/**",
                      "**/test",
                      "@reader/business/testing",
                      "@reader/sqlite/testing"
                    ],
                    "message": "src/ must not import test/ code or a */testing entry (reader-engineering: Testing)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/reader/src/server/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/test/**",
                      "**/test",
                      "@reader/business/testing",
                      "@reader/sqlite/testing"
                    ],
                    "message": "src/ must not import test/ code or a */testing entry (reader-engineering: Testing)"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
