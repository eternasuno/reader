{
  "name": "reader-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "留白 — a self-hosted read-later and feed reader.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "biome check",
    "db:migrate": "pnpm --filter reader db:migrate",
    "dev": "turbo run dev:web dev:server",
    "effect:source": "sh scripts/effect-source.sh",
    "prepare": "effect-tsgo patch",
    "start": "turbo run start",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@effect/tsgo": "^0.67.5",
    "turbo": "2.11.10",
    "typescript": "catalog:"
  }
}
