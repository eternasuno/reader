# Effect HTTP API
API_PORT=3001

# SQLite
# Directory for reader.db and auth.db, relative to the process working
# directory. Created if missing. In Docker, use /data with the mounted volume.
# DATA_DIR=.data

# Better Auth
# Canonical public site origin used for auth URLs.
BETTER_AUTH_URL=http://localhost:3000
# Required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
