# Effect HTTP API
API_PORT=3001

# SurrealDB
# Use an absolute SurrealKV path (for example surrealkv:///data/database) or a
# managed endpoint in production. The default mem:// is ephemeral.
SURREAL_ENDPOINT=mem://
SURREAL_NAMESPACE=app
SURREAL_DATABASE=app

# Better Auth
# Canonical public site origin used for auth URLs.
BETTER_AUTH_URL=http://localhost:3000
# Required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Reader credentials
# Required to store and decrypt per-user reader API keys.
# Must be 32 random bytes encoded as base64. Generate with: openssl rand -base64 32
READER_ENCRYPTION_KEY=
