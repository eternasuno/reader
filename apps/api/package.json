{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "db:migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.2",
    "@mozilla/readability": "^0.6.0",
    "@reader/api": "workspace:*",
    "@reader/business": "workspace:*",
    "@reader/webpage": "workspace:*",
    "@surrealdb/better-auth": "0.1.0",
    "@surrealdb/node": "3.2.0",
    "better-auth": "catalog:",
    "dompurify": "^3.4.17",
    "effect": "4.1.2",
    "feedsmith": "^3.0.1",
    "jsdom": "^31.0.0",
    "surrealdb": "2.2.2"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "catalog:",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
