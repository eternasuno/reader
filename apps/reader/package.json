{
  "name": "reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.server.config.ts && vite build",
    "db:migrate": "tsx --env-file-if-exists=.env src/server/migrate.ts",
    "dev": "turbo run dev:web dev:server",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/main.ts",
    "dev:web": "vite",
    "start": "cd dist && node --env-file-if-exists=../.env server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.4",
    "@effect/sql-sqlite-node": "4.1.4",
    "@mozilla/readability": "^0.6.0",
    "@reader/business": "workspace:*",
    "@reader/content": "workspace:*",
    "@reader/epub": "workspace:*",
    "@reader/mail": "workspace:*",
    "@reader/sqlite": "workspace:*",
    "@reader/webpage": "workspace:*",
    "@solidjs/router": "1.0.1",
    "@tanstack/solid-virtual": "3.13.53",
    "better-auth": "catalog:",
    "dompurify": "^3.4.17",
    "effect": "4.1.4",
    "feedsmith": "^3.0.1",
    "fflate": "^0.8.2",
    "jsdom": "^31.0.0",
    "nodemailer": "^7.0.0",
    "puppeteer-core": "25.16.0",
    "solid-js": "1.9.18",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.4",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "catalog:",
    "daisyui": "5.7.50",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "2.11.15",
    "vitest": "catalog:"
  }
}
