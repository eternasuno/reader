# HTTP server, also the Vite dev proxy target
API_PORT=3001

# Vite dev and preview server; not used by the built app
WEB_PORT=3000

# Directory for reader.db and auth.db, relative to the process working
# directory. Created if missing. In Docker use /data with the mounted volume.
DATA_DIR=.data

# Better Auth signing secret. Required.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Canonical public origin used for auth URLs and the Origin check.
BETTER_AUTH_URL=http://localhost:3000
